---
# P2Poolv2 inventory example (Bitcoin Cash)
#
# Copy this file to get started:
#   cp hosts.yml.example hosts.yml
#
# Secrets (BCHN RPC passwords, API auth, SV2 and Grafana keys) are in
# group_vars/all/vault.yml. See group_vars/all/vault.yml.example for setup.
#
# Each instance needs its own BCHN on the host (not managed by this playbook):
# mainnet RPC 8332, chipnet RPC 48332, each with its own zmqpubhashblock port.
# Mainnet and chipnet run the same P2Poolv2 rules; only the network differs.
#
# If sudo on a host needs a password, run the playbook with -K.

all:
  children:
    p2poolv2_nodes:
      hosts:
        your-server.example.com:
          ansible_user: ubuntu

          p2poolv2_version: "0.0.1-alpha"
          # release: install this fork's GitHub release for p2poolv2_version
          # source:  build p2poolv2_source_ref on the host
          p2poolv2_install_method: release
          # p2poolv2_source_ref: alpha

          # Roles enabled on this host
          p2poolv2_nginx_enabled: true
          p2poolv2_monitoring_enabled: true

          # Nginx -- host-level config
          p2poolv2_domain: your-domain.example.com
          p2poolv2_redirect_domains: []
          p2poolv2_api_port: 46885
          # p2poolv2_api_auth_user: "{{ vault_api_auth_user }}"
          # p2poolv2_api_auth_pass: "{{ vault_api_auth_pass }}"
          # p2poolv2_grafana_domain: grafana.example.com
          # Site configs in sites-enabled to remove (e.g. ones being replaced)
          p2poolv2_nginx_remove_sites: []

          # Grafana listen address: 127.0.0.1 behind nginx, 0.0.0.0 for LAN access
          p2poolv2_grafana_listen_address: "127.0.0.1"
          # Extra Prometheus scrape targets besides the p2poolv2 instances
          # p2poolv2_prometheus_extra_targets:
          #   - job_name: node
          #     target: "localhost:9100"

          # Prometheus and Grafana (roles/monitoring_p2poolv2). Prometheus
          # scrapes every enabled instance's /metrics on 127.0.0.1.
          p2poolv2_monitoring_enabled: true
          p2poolv2_grafana_admin_password: "{{ vault_grafana_admin_password }}"
          # p2poolv2_metrics_auth_user: "{{ vault_api_auth_user }}"
          # p2poolv2_metrics_auth_pass: "{{ vault_api_auth_pass }}"

          p2poolv2_instances:
            # --- Bitcoin Cash mainnet instance ---
            - instance: mainnet
              enabled: false # mainnet has not started yet
              bitcoin_cash_network: mainnet
              bch_share_chain: main
              p2p_listen_address: "/ip4/0.0.0.0/tcp/6884"
              # Share chain peers: Bitcoin Cash has no DNS seeds yet.
              dial_peers: []
              wait_for_chain_sync: true
              stratum_port: 3333
              start_difficulty: 10000
              minimum_difficulty: 100
              bootstrap_address: "bitcoincash:YOUR_MAINNET_ADDRESS"
              # Share address owning every share, or leave it out and let each
              # miner send p2p=<share address>:
              # miner_address: "p2pool:YOUR_SHARE_ADDRESS"
              # Public pool fee in basis points, after the donation; 100 (1%)
              # when fee_address is set without fee:
              # fee_address: "bitcoincash:YOUR_FEE_ADDRESS"
              # fee: 100
              bitcoin_rpc_url: "http://127.0.0.1:8332"
              bitcoin_rpc_user: "{{ vault_bchn_rpc_user }}"
              bitcoin_rpc_pass: "{{ vault_bchn_rpc_pass }}"
              zmq_endpoint: "tcp://127.0.0.1:28332"
              api_port: 46886
              # api_auth_user: "{{ vault_api_auth_user }}"
              # api_auth_pass: "{{ vault_api_auth_pass }}"
              # api_auth_token: "{{ vault_api_auth_token }}"
              # public_dashboard: true
              pool_signature: "P2Poolv2"
              # Stratum V2 with Noise encryption (keys from an external tool):
              # sv2_port: 3336
              # sv2_authority_public_key: "9b..."
              # sv2_authority_secret_key: "{{ vault_sv2_authority_secret_key }}"

            # --- Bitcoin Cash chipnet instance, mini share chain ---
            - instance: chipnet
              bitcoin_cash_network: chipnet
              bch_share_chain: mini
              p2p_listen_address: "/ip4/0.0.0.0/tcp/6885"
              dial_peers: []
              wait_for_chain_sync: true
              stratum_port: 3334
              start_difficulty: 10000
              minimum_difficulty: 100
              bootstrap_address: "bchtest:YOUR_CHIPNET_ADDRESS"
              # miner_address: "tp2pool:YOUR_SHARE_ADDRESS"
              bitcoin_rpc_url: "http://127.0.0.1:48332"
              bitcoin_rpc_user: "{{ vault_bchn_rpc_user }}"
              bitcoin_rpc_pass: "{{ vault_bchn_rpc_pass }}"
              zmq_endpoint: "tcp://127.0.0.1:28333"
              # api_hostname: "127.0.0.1"
              api_port: 46885
              # api_auth_user: "{{ vault_api_auth_user }}"
              # api_auth_pass: "{{ vault_api_auth_pass }}"
              # api_auth_token: "{{ vault_api_auth_token }}"
              pool_signature: "P2Poolv2"
              # sv2_port: 3337
              # stats_dir: "/var/lib/p2poolv2/chipnet/stats"
