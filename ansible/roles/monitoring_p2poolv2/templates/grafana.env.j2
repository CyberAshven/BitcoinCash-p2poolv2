# Grafana settings for P2Poolv2 -- managed by Ansible (monitoring_p2poolv2)
# Read by grafana-server through a systemd drop-in.
GF_SERVER_HTTP_ADDR={{ p2poolv2_grafana_http_addr }}
GF_SERVER_HTTP_PORT={{ p2poolv2_grafana_port }}
{% if p2poolv2_grafana_domain is defined %}
GF_SERVER_DOMAIN={{ p2poolv2_grafana_domain }}
GF_SERVER_ROOT_URL=https://{{ p2poolv2_grafana_domain }}/
{% endif %}
GF_SECURITY_ADMIN_USER={{ p2poolv2_grafana_admin_user }}
# Grafana reads the password from this file (its __FILE convention), so no
# quoting rules apply to it.
GF_SECURITY_ADMIN_PASSWORD__FILE=/etc/grafana/p2poolv2-admin-password
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED={{ p2poolv2_grafana_anonymous_viewer | bool | lower }}
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH={{ p2poolv2_grafana_dashboards_dir }}/pool-provision.json
