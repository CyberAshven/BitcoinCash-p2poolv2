# A second regtest P2Poolv2 node for docker-compose.node.yml. It shares the
# first node's BCHN and dials the first node (docker/config-node2.regtest.toml).
#
#   cp .env.node2.sample .env.node2
#   docker compose -f docker-compose.node.yml -p node2 --env-file .env.node2 up -d
#
# Both nodes use host networking, so every port here must differ from the
# first node's.

NETWORK=regtest
BCH_SHARE_CHAIN=mini

P2POOL_CONFIG=docker/config-node2.regtest.toml

P2POOL_STRATUM_PORT=3334
P2POOL_API_PORT=46885
P2POOL_P2P_HOST=0.0.0.0
P2POOL_P2P_PORT=6885
