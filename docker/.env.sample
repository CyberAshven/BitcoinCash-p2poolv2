# Docker stack settings. Copy to .env (just setup-dev does) and edit.

# Bitcoin Cash network: regtest, chipnet or mainnet. NETWORK is the single
# place a compose deployment picks its network. It selects BCHN's config file,
# and P2Poolv2's bitcoin_cash_network and store directory, so the two cannot
# end up on different networks. It overrides the mounted config.toml.
NETWORK=regtest

# Share chain: "mini" (share target 256 times easier, for small miners) or
# "main". Overrides bch_share_chain in the mounted config.toml and names the
# store directory, because the two are different chains.
BCH_SHARE_CHAIN=mini

# "regtest" adds the CPU miner and its setup. Leave it empty on chipnet and
# mainnet: COMPOSE_PROFILES=
COMPOSE_PROFILES=regtest

RUST_BACKTRACE=0
RUST_LOG=info

# P2Poolv2 config file, relative to the repository root. The sample is a
# regtest node. For chipnet or mainnet, copy it to config.toml, set your
# addresses, dial_peers, wait_for_chain_sync = true and BCHN's RPC port in it,
# and set P2POOL_CONFIG=config.toml here.
P2POOL_CONFIG=config-docker.sample.toml

# P2PoolV2 config overrides
# These are inputs to docker-compose, which passes them to the container as
# P2POOL_STRATUM__PORT, P2POOL_API__PORT and P2POOL_NETWORK__LISTEN_ADDRESS.
# The container-side names use `__` between config sections and keys so that a
# single underscore stays part of a field name; these compose-side names do not.
#
# Any container-side name set in this file reaches the node too, for example
# P2POOL_BITCOINRPC__URL=http://127.0.0.1:48332 to point at another BCHN.
P2POOL_STRATUM_PORT=3333
P2POOL_API_PORT=46884
P2POOL_P2P_HOST=0.0.0.0
P2POOL_P2P_PORT=6884

# BCHN's RPC port, published on the host's loopback for P2Poolv2:
# regtest 18443, chipnet 48332, mainnet 8332. It must match the port in the
# config's [bitcoinrpc] url.
BCHN_RPC_PORT=18443

# Chipnet and mainnet: BCHN's RPC password. Leave it empty and BCHN makes a
# random one on first start and keeps it in the bchn_rpc volume, where
# P2Poolv2 reads it. Set it only to choose your own (no "#"). To read the one
# in use: docker compose exec bchn cat /run/bchn-rpc/password-mainnet
# (or password-chipnet). Regtest always uses the throwaway p2pool / p2pool.
BCHN_RPC_PASSWORD=

# Regtest: blocks the bootstrap mines to BCHN's wallet "miner" before the pool
# starts. 101 leaves one mature coinbase to spend.
REGTEST_INITIAL_BLOCKS=101

# Regtest CPU miner (mujina, Rust), in the "regtest" profile.
# Threads hash at a duty cycle in percent. FORCED_RATE is candidates a minute;
# on regtest each one is a block.
MUJINA_CPUMINER_THREADS=1
MUJINA_CPUMINER_DUTY=50
MUJINA_POOL_FORCED_RATE=6
MUJINA_API_PORT=7785
MUJINA_LOG=info
